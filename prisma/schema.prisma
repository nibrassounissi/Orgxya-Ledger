generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERATEUR
  VALIDATEUR
}

enum AccountStatus {
  PENDING
  APPROVED
  DECLINED
  SUSPENDED
}

model User {
  id           Int           @id @default(autoincrement())
  publicId     String        @unique @default(uuid()) @map("public_id")
  name         String?
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         Role
  status       AccountStatus @default(PENDING) @map("status")
  createdAt    DateTime      @default(now()) @map("created_at")
  reviewedById String?       @map("reviewed_by")
  reviewer     User?         @relation("UserReviewer", fields: [reviewedById], references: [publicId])
  reviewedUsers User[]       @relation("UserReviewer")
  reviewedAt   DateTime?     @map("reviewed_at")

  @@map("users")
}

enum SupplierType {
  INDIVIDUAL
  LEGAL
}

model Supplier {
  id                 Int          @id @default(autoincrement())
  publicId           String       @unique @default(uuid()) @map("public_id")
  name               String
  address            String?
  zipCode            String?      @map("zip_code")
  city               String
  country            String
  phoneNumber        String?      @map("phone_number")
  email              String?
  website            String?
  bankDetails        String?      @map("bank_details")
  vatNumber          String?      @map("vat_number")
  categoryCode       String?      @map("category_code")
  vatCode            String?      @map("vat_code")
  secondaryEstNumber String?      @map("secondary_est_number")
  type               SupplierType
  personalIdNumber   String?      @map("personal_id_number")
  birthDate          DateTime?    @map("birth_date") @db.Date
  taxRateId          Int?         @map("vat_rate_id")
  taxRate            TaxRate?     @relation(fields: [taxRateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invoicePurchases   InvoicePurchase[]
  createdAt          DateTime     @default(now()) @map("created_at")

  @@map("suppliers")
}

enum TaxRateType {
  VAT
  CORPORATE_TAX
  OTHER
}

model TaxRate {
  id                          Int          @id @default(autoincrement())
  publicId                    String       @unique @default(uuid()) @map("public_id")
  value                       Decimal      @map("rate") @db.Decimal(4, 2)
  isFreeAmount                Boolean      @default(false) @map("is_free_amount")
  name                        String
  type                        TaxRateType
  operationCode               String?     @map("operation_code")
  isDefault                   Boolean      @default(false) @map("is_default")
  isAppliedToBasePlusSpecific Boolean      @default(false) @map("is_applied_to_base_plus_specific")
  countryCode                 String       @map("country_code")
  suppliers                   Supplier[]
  createdAt                   DateTime     @default(now()) @map("created_at")

  @@map("tax_rates")
}

enum InvoiceMode {
  OCR_LLM
  HANDWRITTEN
}

enum InvoiceWorkflowStatus {
  EXTRACTED
  TO_VERIFY
  VALIDATED
  EXPORTED
}

model InvoicePurchase {
  id                     Int                    @id @default(autoincrement())
  publicId               String                 @unique @default(uuid()) @map("public_id")
  number                 String
  invoiceDate            DateTime               @map("invoice_date") @db.Date
  currency               String                 @db.VarChar(3)
  totalBeforeTax         Decimal                @map("total_before_tax") @db.Decimal(10, 3)
  stamp                  Decimal                @db.Decimal(10, 3)
  taxAmount              Decimal                @map("tax_amount") @db.Decimal(10, 3)
  totalAfterTax          Decimal                @map("total_after_tax_without_stamp") @db.Decimal(10, 3) @default(0)
  totalAfterTaxWithStamp Decimal                @map("total_after_tax_with_stamp") @db.Decimal(10, 3) @default(0)
  notes                  String?
  dueDate                DateTime?              @map("due_date") @db.Date
  customTaxes            Json?                  @map("custom_taxes")
  isVatDeductible        Boolean                @default(false) @map("is_vat_deductible")

  supplierId             Int                    @map("supplier_id")
  supplier               Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  filePath                String?               @map("file_path")
  mode                    InvoiceMode?
  status                  InvoiceWorkflowStatus  @default(EXTRACTED)
  validationErrors        Json?                 @map("validation_errors")
  validatedById           String?               @map("validated_by")
  validatedAt             DateTime?             @map("validated_at")

  items                   InvoicePurchaseItem[]

  createdAt               DateTime              @default(now()) @map("created_at")

  @@map("invoices_purchases")
}

model InvoicePurchaseItem {
  id             Int             @id @default(autoincrement())
  publicId       String          @unique @default(uuid()) @map("public_id")
  label          String
  quantity       Decimal         @db.Decimal(10, 1)
  unitPrice      Decimal         @map("unit_price") @db.Decimal(10, 3)
  totalBeforeTax Decimal         @map("total_before_tax") @db.Decimal(10, 3)
  taxRate        Decimal         @map("tax_rate") @db.Decimal(4, 2)
  taxAmount      Decimal         @map("tax_amount") @db.Decimal(10, 3)
  totalAfterTax  Decimal         @map("total_after_tax") @db.Decimal(10, 3)

  invoiceId      Int             @map("invoice_id")
  invoice        InvoicePurchase @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("invoice_items_purchases")
}